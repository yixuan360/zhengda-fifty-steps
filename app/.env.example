# 郑大五十步 — App 环境变量
# 复制为 .env 并填入实际值

# API 地址：模拟器 http://10.0.2.2:8000；真机填电脑局域网 IP；生产用 https
# API 地址：开发用 http://localhost:8000；生产用 http://123.57.94.91
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# 高德 Android 原生 Key（绑定包名 + 签名 SHA1，与 Web 服务 Key 不同类型）
EXPO_PUBLIC_AMAP_ANDROID_KEY=YOUR_AMAP_ANDROID_KEY
# 高德 Web 服务 Key（预留，当前未使用）
EXPO_PUBLIC_AMAP_API_KEY=your_amap_api_key_here
EXPO_PUBLIC_WECHAT_APP_ID=your_wechat_app_id_here

# 文脉叙事引擎：默认 false，关闭时与线上版本行为完全一致
EXPO_PUBLIC_NARRATIVE_ENABLED=false
# Agent 服务地址：模拟器 http://10.0.2.2:8100；真机填电脑局域网 IP；生产 https://<host>/agent
EXPO_PUBLIC_AGENT_BASE_URL=
