# 文脉叙事 Agent 服务环境变量模板
# 复制为 agent.env（已在 .gitignore 中忽略）后填入真实值；不要把真实密钥提交入库。

# OpenAI 兼容 LLM（必填）
NARRATIVE_LLM_BASE_URL=https://your-llm-gateway.example.com/v1
NARRATIVE_LLM_API_KEY=<your-api-key>
NARRATIVE_LLM_MODEL=<your-model-name>

# Chroma 向量库目录（可选，默认仓库根/server/vector_db）
NARRATIVE_VECTOR_DIR=/opt/zhengda-fifty-steps/server/vector_db

# 音频缓存目录（可选，默认 agent_service/media_cache）
NARRATIVE_MEDIA_CACHE=/opt/zhengda-fifty-steps/agent_service/media_cache
