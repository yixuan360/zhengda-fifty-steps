# 郑大五十步 V3 staging — Gunicorn
# 安装：cp 到 /etc/systemd/system/gunicorn-zhengda-v3.service
# 端口 8001 只监听本机，由 nginx /api/v2/narrative/ 转发。

[Unit]
Description=郑大五十步 V3 staging Gunicorn
After=network.target mysql.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/zhengda-v3/server
ExecStart=/opt/zhengda-v3/server/venv/bin/gunicorn \
    --workers 1 \
    --bind 127.0.0.1:8001 \
    --timeout 60 \
    --access-logfile /var/log/zhengda-v3-gunicorn-access.log \
    --error-logfile /var/log/zhengda-v3-gunicorn-error.log \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
