# 郑大五十步 — 生产环境 .env（服务器上 /opt/zhengda-fifty-steps/server/.env）

# ⚠ ！！！改成 False！！！
DEBUG=False

# ⚠ ！！！用下面命令生成随机密钥（在服务器上执行）！！！
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=改成上面命令输出的随机密钥

# ⚠ ！！！加 ECS 公网 IP！！！
ALLOWED_HOSTS=localhost,127.0.0.1,123.57.94.91

# ⚠ ！！！MySQL 密码不要用 123456！！！
DB_NAME=zhengda
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_HOST=localhost
DB_PORT=3306

# Admin 路径
ADMIN_URL=manage/

# 微信开放平台（演示占位）
WECHAT_APP_ID=wx_demo
WECHAT_APP_SECRET=demo_secret

# ⚠ ！！！生产不能空！！！
CORS_ALLOWED_ORIGINS=http://123.57.94.91

# ⚠ ！！！生产必须填！！！
CSRF_TRUSTED_ORIGINS=http://123.57.94.91

# 高德 Web 端（JS API）key + 安全密钥（Admin 触发区域地图编辑器用，须配对）
# 到 console.amap.com 创建 "Web端(JS API)" 类型 key；白名单需含 123.57.94.91（或留空）
AMAP_WEB_KEY=
AMAP_WEB_SECURITY_CODE=
