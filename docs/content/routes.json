    "stops": [
      {"order": 1, "spot_id": 1, "category": "", "duration_seconds": 90, "optional": false, "indoor": false, "note": "南大门"},
      {"order": 2, "spot_id": 3, "category": "", "duration_seconds": 90, "optional": false, "indoor": false, "note": "综合中心大楼（行政楼）"},
      {"order": 3, "spot_id": 16, "category": "architecture", "duration_seconds": 120, "optional": false, "indoor": false, "note": "钟楼"}
    ],
    "narratives": [
      {
        "key": "intro",
        "kind": "intro",
        "text": "从南门进校，沿中轴往北，经过综合中心，最后到钟楼。三站，讲的是入口、治理和时间。",
        "sources": [],
        "fact_notes": []
      },
      {
        "key": "t1",
        "kind": "transition",
        "from_order": 1,
        "to_order": 2,
        "text": "南门是入口，综合中心是秩序。从校门到行政中枢，先看一所大学怎么把人迎进来。",
        "sources": [],
        "fact_notes": []
      },
      {
        "key": "t2",
        "kind": "transition",
        "from_order": 2,
        "to_order": 3,
        "text": "从治理到时间。行政楼讲的是秩序，钟楼讲的是这所大学共同的时间。",
        "sources": [],
        "fact_notes": []
      },
      {
        "key": "outro",
        "kind": "outro",
        "text": "三站走完：入口、治理、时间。如果还有时间，可以去图书馆和计算机学院，看另一条线。",
        "sources": [],
        "fact_notes": []
      }
    ]
  }
]
