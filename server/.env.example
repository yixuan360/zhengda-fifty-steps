# 郑大五十步 — Django 环境变量
# 复制为 .env 后按环境填写，不要提交到 git

# ============================================================
# 安全（生产环境务必修改）
# ============================================================
SECRET_KEY=dev-secret-key-change-in-production-abc123
# 生产：DEBUG=False，访问 admin 和 API 均不显示 debug 页面
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# 生产示例：ALLOWED_HOSTS=api.zhengda.com,www.zhengda.com

# ============================================================
# MySQL 数据库
# ============================================================
DB_NAME=zhengda
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ============================================================
# Admin 后台路径（非默认值，安全加固，v4.0 §4.3）
# ============================================================
ADMIN_URL=manage/

# ============================================================
# 景点编辑器写 API 密钥（App 地图绘制模式，X-Editor-Key 头比对）
# 课程项目简化鉴权：密钥会打进 App 包（公开），仅用于开发期自测，生产需换正式鉴权
# ============================================================
EDITOR_KEY=dev_editor_key_change_me

# ============================================================
# 微信开放平台（V1 占位，真实对接时替换）
# ============================================================
WECHAT_APP_ID=wx_dev_placeholder
WECHAT_APP_SECRET=dev_secret_placeholder

# ============================================================
# CORS（开发留空=允许全部; 生产写域名, 多个逗号分隔）
# ============================================================
CORS_ALLOWED_ORIGINS=
# 生产示例：CORS_ALLOWED_ORIGINS=https://app.zhengda.com

# ============================================================
# CSRF 可信源（生产必填: Nginx 代理的 HTTPS 域名）
# ============================================================
CSRF_TRUSTED_ORIGINS=
# 生产示例：CSRF_TRUSTED_ORIGINS=https://api.zhengda.com
